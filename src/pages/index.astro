---
import Analytics from "../components/Analytics.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const emailHref = "mailto:info@02signal.ai?subject=Teekaart.ee%20-%20omaniku%20esimene%20suund";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://teekaart.ee/#organization",
      name: "Teekaart.ee",
      legalName: "Ettevõtluskeskus OÜ",
      url: "https://teekaart.ee/",
      email: "info@02signal.ai",
      telephone: "+37258180435",
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer support",
        telephone: "+37258180435",
        email: "info@02signal.ai",
        areaServed: "EE",
        availableLanguage: ["et"]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://teekaart.ee/#website",
      name: "Teekaart.ee",
      url: "https://teekaart.ee/",
      publisher: { "@id": "https://teekaart.ee/#organization" },
      inLanguage: "et"
    },
    {
      "@type": "Service",
      "@id": "https://teekaart.ee/#service",
      name: "Ettevõtte järgmise praktilise sammu teekaart",
      serviceType: "Digitaliseerimise, automatiseerimise ja toetuse võimaluse suunav eelhindamine",
      provider: { "@id": "https://teekaart.ee/#organization" },
      areaServed: "EE",
      audience: {
        "@type": "Audience",
        audienceType: "Eesti ettevõtte omanikud ja juhid"
      },
      offers: [
        {
          "@type": "Offer",
          name: "Esmane suunav vastus",
          price: "0",
          priceCurrency: "EUR"
        },
        {
          "@type": "Offer",
          name: "Omaniku ühe lehe teekaart",
          priceSpecification: {
            "@type": "PriceSpecification",
            minPrice: "390",
            priceCurrency: "EUR"
          }
        },
        {
          "@type": "Offer",
          name: "Tööde ja toetuse võimaluse ülevaatus",
          priceSpecification: {
            "@type": "PriceSpecification",
            minPrice: "1200",
            priceCurrency: "EUR"
          }
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://teekaart.ee/#faq",
      mainEntity: [
        {
          "@type": "Question",
          name: "Kas teekaart on sama mis digiteekaart?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Ei. Teekaart.ee aitab valida õige esimese suuna. Digiteekaart.ee keskendub EIS digiteekaardi ja toetuste eelhindamisele."
          }
        },
        {
          "@type": "Question",
          name: "Kas pean teadma, millist tarkvara vaja on?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Ei pea. Piisab sellest, kui kirjeldate, mis töö täna aega raiskab või segadust tekitab."
          }
        }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="et">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Teekaart.ee | Leidke ettevõtte järgmine praktiline samm</title>
    <meta
      name="description"
      content="Teekaart.ee aitab ettevõtte omanikul aru saada, kas järgmine samm on digiteekaart, digitaliseerimine, automatiseerimine või väiksem praktiline töö."
    />
    <link rel="canonical" href="https://teekaart.ee/" />
    <meta property="og:title" content="Teekaart.ee | Milline tee sobib teie ettevõttele?" />
    <meta
      property="og:description"
      content="Kirjeldage, mis ettevõttes praegu segab. Saate lihtsa omaniku vastuse: kas alustada toetuse kontrollist, digitaliseerimisest, automatiseerimisest või väiksemast praktilisest tööst."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://teekaart.ee/" />
    <meta property="og:image" content="https://teekaart.ee/hero-teekaart.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <Analytics />
  </head>
  <body>
    <header class="topbar">
      <nav class="nav" aria-label="Põhinavigeerimine">
        <a class="brand" href="/">Teekaart.ee</a>
        <div class="navlinks">
          <a href="#abiline">Abiline</a>
          <a href="#teed">Võimalikud teed</a>
          <a href="#vastus">Mida saate</a>
          <a href="#hinnad">Hinnad</a>
          <a href="/omaniku-teekaart/">Näidis</a>
          <a href="/faq/">FAQ</a>
          <a href="#kontakt">Kontakt</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero hero-road">
        <div class="hero-inner">
          <span class="eyebrow">Kui on vaja edasi liikuda, aga õige alguskoht ei ole selge</span>
          <h1>Leidke oma ettevõttele järgmine praktiline samm</h1>
          <p>
            Te ei pea teadma, kas vaja on toetust, uut tarkvara, automaatikat või lihtsalt paremat töökorraldust.
            Kirjeldage mure ära ja aitame valida esimese mõistliku tee.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="#kontakt" data-track-event="cta_click" data-track-label="hero_start">Alustan lühikese kirjeldusega</a>
            <a class="btn btn-secondary" href="tel:+37258180435" data-track-event="phone_click" data-track-label="hero_phone">Helista +372 5818 0435</a>
          </div>
          <div class="route-signs" aria-label="Võimalikud järgmised teed">
            <a href="https://digiteekaart.ee/" data-track-event="partner_site_click" data-track-label="hero_sign_digiteekaart">Toetus ja digiteekaart</a>
            <a href="https://digitaliseerimine.ee/" data-track-event="partner_site_click" data-track-label="hero_sign_digitaliseerimine">Paber, Excel, vana tarkvara</a>
            <a href="https://automatiseerimine.ee/" data-track-event="partner_site_click" data-track-label="hero_sign_automatiseerimine">Korduv töö automaatseks</a>
            <a href="#kontakt" data-track-event="cta_click" data-track-label="hero_sign_unknown">Ei tea, kust alustada</a>
          </div>
          <div class="proof">
            <div><strong>1 suund</strong><span>ütleme, kust on mõistlik alustada</span></div>
            <div><strong>1 tööpäev</strong><span>esmane vastus pärast vormi</span></div>
            <div><strong>ilma IT-keerukuseta</strong><span>omaniku keeles, mitte süsteemi keeles</span></div>
          </div>
        </div>
      </section>

      <section id="abiline" class="white">
        <div class="section-inner tool-grid">
          <div>
            <span class="kicker">Omaniku suunavalik</span>
            <h2>Milline tee tundub teie olukorras esimene?</h2>
            <p>
              Kui valikuid on mitu, ei pea omanik alustama teenuse nimest. Vastake neljale küsimusele
              ja saate kohe lihtsa suuna.
            </p>
            <ul class="check">
              <li>toetus ei ole alati esimene samm</li>
              <li>vana tarkvara ei pea alati kohe välja vahetama</li>
              <li>väike korduv töö võib anda kiirema võidu kui suur projekt</li>
            </ul>
          </div>

          <div class="tool-card" data-roadmap-tool>
            <div class="tool-questions">
              <label>
                <span>Mis teid praegu kõige rohkem segab?</span>
                <select data-roadmap-input="pain">
                  <option value="unknown">Ei tea, kust alustada</option>
                  <option value="support">Tahaks aru saada toetuse võimalusest</option>
                  <option value="digital">Paber, Excel või vana tarkvara</option>
                  <option value="automation">Korduv käsitöö võtab aega</option>
                </select>
              </label>
              <label>
                <span>Kas üks konkreetne töö on juba teada?</span>
                <select data-roadmap-input="clarity">
                  <option value="unclear">Ei ole veel selge</option>
                  <option value="one">Jah, üks töö on teada</option>
                  <option value="many">Võimalusi on mitu</option>
                </select>
              </label>
              <label>
                <span>Kas soovite rahastuse võimalust kontrollida?</span>
                <select data-roadmap-input="support">
                  <option value="maybe">Ei tea, võib-olla</option>
                  <option value="yes">Jah</option>
                  <option value="no">Praegu mitte</option>
                </select>
              </label>
              <label>
                <span>Kui kiiresti soovite esimese otsuse teha?</span>
                <select data-roadmap-input="speed">
                  <option value="soon">1-2 nädala jooksul</option>
                  <option value="month">Selle kuu jooksul</option>
                  <option value="later">Hiljem, tahan enne aru saada</option>
                </select>
              </label>
            </div>
            <button class="btn btn-primary" type="button" data-roadmap-calculate>Näita soovitatud suunda</button>
            <div class="tool-result" data-roadmap-result>
              <span class="tag">Näidis</span>
              <h3>Alustage suunavast vastusest</h3>
              <p>Kui õige tee ei ole veel selge, on mõistlik enne raha kulutamist saada lühike omaniku vaade.</p>
            </div>
            <div class="inline-actions">
              <a class="btn btn-light" href="#kontakt" data-roadmap-cta data-track-event="cta_click" data-track-label="roadmap_tool_contact">Kirjeldan olukorda</a>
              <a class="btn btn-secondary dark" href="tel:+37258180435" data-track-event="phone_click" data-track-label="roadmap_tool_phone">Helista</a>
            </div>
          </div>
        </div>
      </section>

      <section id="teed" class="white">
        <div class="section-inner">
          <div class="section-head">
            <span class="kicker">Neli võimalikku teed</span>
            <h2>Ühel ettevõttel ei ole vaja kõiki lahendusi korraga.</h2>
            <p>
              Tavaliselt on õige alustada ühest selgest küsimusest: kas mure on rahastuses,
              töökorralduses, korduvates käsitöödes või kliendiinfo liikumises?
            </p>
          </div>
          <div class="grid-4">
            <article class="card route-card">
              <span class="stat">01</span>
              <h3>Toetus ja digiteekaart</h3>
              <p>Kui soovite aru saada, kas EIS digiteekaart, RTE või mõni muu meede võiks teie plaani aidata.</p>
              <a href="https://digiteekaart.ee/" data-track-event="partner_site_click" data-track-label="route_digiteekaart">Vaata digiteekaardi suunda</a>
            </article>
            <article class="card route-card">
              <span class="stat">02</span>
              <h3>Paber, Excel ja vana tarkvara</h3>
              <p>Kui sama info kirjutatakse mitu korda ümber või vana süsteem takistab igapäevast tööd.</p>
              <a href="https://digitaliseerimine.ee/" data-track-event="partner_site_click" data-track-label="route_digitaliseerimine">Vaata digitaliseerimise suunda</a>
            </article>
            <article class="card route-card">
              <span class="stat">03</span>
              <h3>Korduv töö automaatseks</h3>
              <p>Kui inimesed saadavad samu teateid, koostavad samu faile või kontrollivad samu andmeid käsitsi.</p>
              <a href="https://automatiseerimine.ee/" data-track-event="partner_site_click" data-track-label="route_automatiseerimine">Vaata automatiseerimise suunda</a>
            </article>
            <article class="card route-card">
              <span class="stat">04</span>
              <h3>Ei tea, kust alustada</h3>
              <p>Kui variante on mitu ja omanik tahab enne raha kulutamist saada rahuliku esimese hinnangu.</p>
              <a href="#kontakt" data-track-event="cta_click" data-track-label="route_unknown">Kirjeldan olukorda</a>
            </article>
          </div>
        </div>
      </section>

      <section id="vastus" class="sky">
        <div class="section-inner offer">
          <div>
            <span class="kicker">Mida vastu saate</span>
            <h2>Lühike omaniku vastus, mitte pikk konsultatsiooniraport.</h2>
            <p>
              Esimene vastus peab aitama otsustada. Kas minna toetuse eelhindamisse,
              teha väike töökorralduse korrastus, alustada automaatikaga või mitte praegu midagi suurt teha.
            </p>
            <ul class="pain-list">
              <li>mis on teie kirjeldatud mure tõenäoline tüüp</li>
              <li>milline esimene samm tundub kõige turvalisem</li>
              <li>kas toetuse kontroll on mõistlik või raiskaks aega</li>
              <li>millist infot on enne pakkumist veel vaja</li>
              <li>mida praegu mitte teha, et raha mitte lukku panna</li>
            </ul>
          </div>
          <aside class="sample">
            <div class="sample-top">
              <strong>Näidisvastus</strong>
              <span>omaniku keeles</span>
            </div>
            <div class="sample-body">
              <span class="tag">Tee: väike digitaliseerimine</span>
              <h3>Alustage tellimuse info liikumisest, mitte kogu tarkvara vahetusest.</h3>
              <p>
                Teie kirjeldus viitab sellele, et esimene kasu tuleb ühest vormist,
                andmete korrastamisest ja teavitusest. Toetuse võimalust tasub kontrollida,
                aga enne peab töö täpsemalt piiritlema.
              </p>
              <div class="sample-row"><span>Järgmine samm</span><strong>ühe töö lühike plaan</strong></div>
              <div class="sample-row"><span>Otsus</span><strong>väike projekt enne suurt süsteemi</strong></div>
              <div class="sample-row"><span>Risk</span><strong>vana info on mitmes kohas laiali</strong></div>
              <div class="inline-actions">
                <a class="btn btn-primary" href="#kontakt" data-track-event="cta_click" data-track-label="sample_request">Soovin sellist vastust</a>
                <a class="btn btn-light" href="/omaniku-teekaart/" data-track-event="cta_click" data-track-label="sample_page">Vaata näidist</a>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section class="graphite">
        <div class="section-inner">
          <div class="section-head">
            <span class="kicker">Miks see leht olemas on</span>
            <h2>Omanik ei pea alustama õige teenuse nime teadmisest.</h2>
            <p>
              Sageli teab omanik väga hästi, mis häirib, aga ei tea, kas seda nimetada
              digitaliseerimiseks, automatiseerimiseks, AI-ks, tarkvaraks või toetuse projektiks.
              Meie tõlgime mure praktiliseks järgmiseks sammuks.
            </p>
          </div>
          <div class="steps">
            <div class="step">
              <strong>01</strong>
              <div>
                <h3>Teie kirjeldate olukorda</h3>
                <p>Ühe või kahe lõiguga. Ei pea kasutama tehnilisi sõnu ega nimetama õiget lahendust.</p>
              </div>
            </div>
            <div class="step">
              <strong>02</strong>
              <div>
                <h3>Me eristame õige suuna</h3>
                <p>Toetus, digitaliseerimine, automaatika, AI abiline või enne lihtsalt info korda.</p>
              </div>
            </div>
            <div class="step">
              <strong>03</strong>
              <div>
                <h3>Jätkate ainult siis, kui samm on mõistlik</h3>
                <p>Kui jätkata, lepime järgmise töö mahu ja hinna enne alustamist kokku.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="hinnad" class="white">
        <div class="section-inner">
          <div class="section-head">
            <span class="kicker">Selge raam</span>
            <h2>Alustada saab väikese otsusega.</h2>
          </div>
          <div class="grid-3">
            <article class="card">
              <span class="stat">0 €</span>
              <h3>Esmane suunav vastus</h3>
              <p>Kirjeldate olukorda. Saate lühikese vastuse, milline tee tundub esimesena mõistlik.</p>
              <ul class="check">
                <li>suuna soovitus</li>
                <li>puuduva info nimekiri</li>
                <li>kas tasub edasi rääkida</li>
              </ul>
            </article>
            <article class="card">
              <span class="stat">390 €</span>
              <h3>Omaniku ühe lehe teekaart</h3>
              <p>Paneme ühe mure lihtsaks pildiks: mis on probleem, mis on esimene samm ja mis võiks maksta.</p>
              <ul class="check">
                <li>1 lehe praktiline kokkuvõte</li>
                <li>järgmise sammu hinnaraam</li>
                <li>toetuse kontrolli vajadus</li>
              </ul>
            </article>
            <article class="card">
              <span class="stat">1200 €</span>
              <h3>Tööde ja toetuse ülevaatus</h3>
              <p>Kui ettevõttes on mitu mõtet korraga, aitame valida, millest alustada ja mida praegu mitte puutuda.</p>
              <ul class="check">
                <li>3-7 mure või töö võrdlus</li>
                <li>üks soovitatud esimene projekt</li>
                <li>toetuse ja teostuse sobivuse vaade</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section id="kontakt" class="lead-section">
        <div class="section-inner lead-grid">
          <div>
            <span class="kicker">Alustame</span>
            <h2>Kirjeldage, mis ettevõttes praegu segab.</h2>
            <p>
              Vastame ühe tööpäeva jooksul. Kui on kiire, helistage:
              <a href="tel:+37258180435" data-track-event="phone_click" data-track-label="lead_section_phone">+372 5818 0435</a>.
            </p>
            <ul class="check">
              <li>te ei pea teadma õiget teenuse nime</li>
              <li>me ei lükka kohe suurt projekti peale</li>
              <li>me ütleme ka siis, kui esmalt pole mõistlik midagi teha</li>
            </ul>
          </div>

          <div class="lead-card">
            <form id="lead-form" data-site-lead-form data-source-site="teekaart.ee">
              <input type="text" name="website" autocomplete="off" tabindex="-1" style="position:absolute;left:-9999px" aria-hidden="true" />
              <div class="form-grid">
                <div class="field">
                  <label for="company">Ettevõte *</label>
                  <input id="company" name="company" autocomplete="organization" required placeholder="Ettevõtte nimi" />
                </div>
                <div class="field">
                  <label for="name">Nimi *</label>
                  <input id="name" name="name" autocomplete="name" required placeholder="Kuidas teie poole pöörduda" />
                </div>
                <div class="field">
                  <label for="email">E-mail *</label>
                  <input id="email" name="email" type="email" autocomplete="email" required placeholder="teie@ettevote.ee" />
                </div>
                <div class="field">
                  <label for="phone">Telefon</label>
                  <input id="phone" name="phone" autocomplete="tel" placeholder="+372 ..." />
                </div>
                <div class="field">
                  <label for="mainPain">Mis on peamine mure?</label>
                  <select id="mainPain" name="mainPain">
                    <option value="">Valige</option>
                    <option>Toetuse võimalus</option>
                    <option>Paber, Excel või vana tarkvara</option>
                    <option>Korduv käsitöö</option>
                    <option>Kliendile vastamine või müük</option>
                    <option>Ei tea, kust alustada</option>
                  </select>
                </div>
                <div class="field">
                  <label for="size">Ettevõtte suurus</label>
                  <select id="size" name="size">
                    <option value="">Valige</option>
                    <option>1-10 inimest</option>
                    <option>11-50 inimest</option>
                    <option>51-250 inimest</option>
                    <option>250+ inimest</option>
                  </select>
                </div>
                <div class="field full">
                  <label for="problem">Mis täna kõige rohkem aega, raha või rahu võtab? *</label>
                  <textarea id="problem" name="problem" required placeholder="Näiteks: tellimused tulevad e-maili, kirjutame Excelisse ja hiljem arveprogrammi. Ei tea, kas alustada toetusest või väiksemast lahendusest."></textarea>
                </div>
                <div class="field full">
                  <label for="goal">Mida tahaksite 3 kuu pärast paremini näha?</label>
                  <input id="goal" name="goal" placeholder="Näiteks: vähem ümberkirjutamist, kiirem vastamine, selgem tööde ülevaade..." />
                </div>
              </div>
              <label class="consent">
                <input type="checkbox" name="consent" required />
                <span>Nõustun, et Ettevõtluskeskus OÜ kasutab neid andmeid minu päringule vastamiseks. Soovi korral võite saata infot sobivate toetuste ja praktiliste digitaliseerimise võimaluste kohta.</span>
              </label>
              <button class="btn btn-primary" type="submit">Saada päring</button>
              <p class="form-note">Vastame ühe tööpäeva jooksul. Kontaktandmeid ei müüda ega anta kolmandatele osapooltele.</p>
              <p class="status-text" id="form-status" aria-live="polite"></p>
            </form>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline define:vars={{ emailHref }}>
      const form = document.querySelector("#lead-form");
      const statusEl = document.querySelector("#form-status");

      const getAttribution = () => {
        if (typeof window.teekaartGetAttribution === "function") {
          return window.teekaartGetAttribution();
        }
        return {};
      };

      const getLastCta = () => {
        if (typeof window.teekaartGetLastCta === "function") {
          return window.teekaartGetLastCta();
        }
        return {};
      };

      const track = (eventName, params = {}) => {
        if (typeof window.teekaartTrack === "function") {
          window.teekaartTrack(eventName, params);
        }
      };

      const toPlainText = (payload) => {
        return [
          "Teekaart.ee päring",
          "",
          `Ettevõte: ${payload.company}`,
          `Nimi: ${payload.name}`,
          `E-mail: ${payload.email}`,
          `Telefon: ${payload.phone || "-"}`,
          `Peamine mure: ${payload.mainPain || "-"}`,
          `Suurus: ${payload.size || "-"}`,
          `Soovitud seis: ${payload.goal || "-"}`,
          "",
          "Olukorra kirjeldus:",
          payload.problem,
          "",
          "Attribution:",
          `Landing: ${payload.attribution?.landingPage || "-"}`,
          `UTM source: ${payload.attribution?.utm_source || "-"}`,
          `UTM campaign: ${payload.attribution?.utm_campaign || "-"}`,
          `Last CTA: ${payload.lastCta?.cta_label || "-"}`
        ].join("\n");
      };

      const mailFallback = (payload) => {
        const body = encodeURIComponent(toPlainText(payload));
        window.location.href = `${emailHref}&body=${body}`;
      };

      const roadmapTool = document.querySelector("[data-roadmap-tool]");
      const roadmapResult = document.querySelector("[data-roadmap-result]");
      const roadmapButton = document.querySelector("[data-roadmap-calculate]");
      const roadmapCta = document.querySelector("[data-roadmap-cta]");
      let roadmapToolStarted = false;

      const getRoadmapValue = (name) => document.querySelector(`[data-roadmap-input="${name}"]`)?.value || "";
      const trackRoadmap = (eventName, params = {}) => {
        if (typeof window.teekaartTrack === "function") {
          window.teekaartTrack(eventName, {
            source_site: "teekaart.ee",
            ...params
          });
        }
      };

      const selectRoute = () => {
        const pain = getRoadmapValue("pain");
        const clarity = getRoadmapValue("clarity");
        const support = getRoadmapValue("support");

        if (pain === "support" || support === "yes") {
          return {
            route: "digiteekaart",
            title: "Kontrollige esmalt toetuse ja digiteekaardi võimalust",
            text: "Kui rahastus on oluline, tasub enne projekti tellimist vaadata, kas plaan võiks sobida EIS-i või RTE suunaga.",
            href: "https://digiteekaart.ee/",
            label: "roadmap_result_digiteekaart"
          };
        }

        if (pain === "automation" && clarity === "one") {
          return {
            route: "automatiseerimine",
            title: "Võtke üks korduv töö ja kontrollige automaatika sobivust",
            text: "Kui üks tüütu töö on juba teada, on kiireim tee vaadata, kas seda saab väikese abilisega lihtsamaks teha.",
            href: "https://automatiseerimine.ee/",
            label: "roadmap_result_automatiseerimine"
          };
        }

        if (pain === "digital" || clarity === "one") {
          return {
            route: "digitaliseerimine",
            title: "Alustage ühest paberil, Excelis või vanas tarkvaras kinni olevast tööst",
            text: "Ärge vahetage kohe kogu süsteemi. Kõigepealt tasub leida üks töö, mille korrastamine annab nähtava kasu.",
            href: "https://digitaliseerimine.ee/",
            label: "roadmap_result_digitaliseerimine"
          };
        }

        return {
          route: "teekaart",
          title: "Küsige lühike omaniku suunav vastus",
          text: "Kui variante on mitu või alguskoht ei ole selge, on mõistlik saada ühe tööpäeva jooksul rahulik esimene suund.",
          href: "#kontakt",
          label: "roadmap_result_contact"
        };
      };

      roadmapTool?.addEventListener("change", () => {
        if (roadmapToolStarted) return;
        roadmapToolStarted = true;
        trackRoadmap("tool_start", {
          tool_name: "owner_route_selector"
        });
      });

      roadmapButton?.addEventListener("click", () => {
        const route = selectRoute();
        const speed = getRoadmapValue("speed");

        if (roadmapResult) {
          roadmapResult.innerHTML = `
            <span class="tag">Soovitatud suund: ${route.route}</span>
            <h3>${route.title}</h3>
            <p>${route.text}</p>
          `;
        }

        if (roadmapCta) {
          roadmapCta.setAttribute("href", route.href);
          roadmapCta.setAttribute("data-track-label", route.label);
          roadmapCta.textContent = route.route === "teekaart" ? "Kirjeldan olukorda" : "Ava soovitatud suund";
        }

        trackRoadmap("tool_completed", {
          tool_name: "owner_route_selector",
          result_route: route.route,
          pain: getRoadmapValue("pain"),
          clarity: getRoadmapValue("clarity"),
          support_interest: getRoadmapValue("support"),
          speed
        });

        if (route.route !== "teekaart" || speed === "soon") {
          trackRoadmap("result_high_intent", {
            tool_name: "owner_route_selector",
            result_route: route.route,
            speed
          });
        }
      });

      // Carry the meaningful part of the form into the AMOS lead capture
      // (context.field / context.outcomes on the envelope) so a subscriber
      // arrives with what they told us, not an empty address. `field` is
      // clipped to 64 chars server-side; each outcome to 240. mainPain is a
      // short dropdown label, so it fits `field` directly; the free-text
      // problem/goal descriptions go into outcomes, where the 240-char cap
      // is generous enough to keep them whole.
      const toAmosOutcomes = (payload) => [
        payload.size ? `Ettevõtte suurus: ${payload.size}` : null,
        payload.problem ? `Praegune olukord: ${payload.problem}` : null,
        payload.goal ? `Soovitud seis 3 kuu pärast: ${payload.goal}` : null
      ].filter(Boolean);

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const formData = new FormData(form);
        if (formData.get("website")) return;

        const payload = {
          source_site: "teekaart.ee",
          submitted_at: new Date().toISOString(),
          company: String(formData.get("company") || "").trim(),
          name: String(formData.get("name") || "").trim(),
          email: String(formData.get("email") || "").trim(),
          phone: String(formData.get("phone") || "").trim(),
          mainPain: String(formData.get("mainPain") || "").trim(),
          size: String(formData.get("size") || "").trim(),
          problem: String(formData.get("problem") || "").trim(),
          goal: String(formData.get("goal") || "").trim(),
          consent: Boolean(formData.get("consent")),
          attribution: getAttribution(),
          lastCta: getLastCta()
        };

        track("lead_form_submit_attempt", {
          form_name: "teekaart_suunav_paring",
          main_pain: payload.mainPain,
          company_size: payload.size
        });

        statusEl.textContent = "Saadan...";

        try {
          const response = await fetch("/api/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              kind: "topic_subscribe",
              email: payload.email,
              topic: "projekt",
              field: payload.mainPain.slice(0, 64) || null,
              outcomes: toAmosOutcomes(payload),
              source_site: "funnel_teekaart"
            })
          });
          const responseBody = await response.json().catch(() => null);
          if (!response.ok || !responseBody?.ok) throw new Error(`AMOS capture failed: ${response.status}`);

          track("lead_form_submit", {
            form_name: "teekaart_suunav_paring",
            submit_mode: "amos",
            main_pain: payload.mainPain
          });
          form.reset();
          statusEl.textContent = "Aitäh. Päring on käes. Vastame ühe tööpäeva jooksul.";
        } catch {
          // No lead_form_submit here: mailto is a fallback for a failed AMOS
          // capture, not a confirmed submission - the person still has to
          // press Send themselves. lead_form_submit_attempt (above) already
          // marks the attempt, so the gap reads as "capture failed, fell
          // back to mailto" instead of a false conversion.
          statusEl.textContent = "Automaatne saatmine ei õnnestunud. Avan e-maili varuvariandi.";
          mailFallback(payload);
        }
      });
    </script>
  </body>
</html>
